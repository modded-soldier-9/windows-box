<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WindowsBox.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:WindowsBox.App.Pages"
    Title="Windows Box">

    <Grid>
        <NavigationView
            x:Name="RootNav"
            PaneDisplayMode="Left"
            IsSettingsVisible="True"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            OpenPaneLength="240"
            CompactPaneLength="48"
            SelectionChanged="RootNav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home" Icon="Home" />
                <NavigationViewItem Content="Services" Tag="services" Icon="Setting" />
                <NavigationViewItem Content="Software" Tag="software" Icon="Shop" />
                <NavigationViewItem Content="Privacy" Tag="privacy" Icon="Permissions" />
                <NavigationViewItem Content="Startup" Tag="startup" Icon="Play" />
                <NavigationViewItem Content="Tweaks" Tag="tweaks" Icon="Edit" />
                <NavigationViewItem Content="History" Tag="history" Icon="Clock" />
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <TextBlock
                    Margin="16,8"
                    Opacity="0.55"
                    FontSize="11"
                    Text="Zero footprint · MIT · no phone-home" />
            </NavigationView.PaneFooter>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
